# Copy to .env (`yarn setup` does, with a random SESSION_SECRET).

# The address people use. The OIDC callback, the CSRF check, canonical URLs and
# the sitemap are built from it. In development it's the Vite dev server.
PUBLIC_URL=http://localhost:3000

# Ports in development: Vite (WEB_PORT) forwards /api and /auth to the BFF
# (PORT). `yarn setup` sets both in a git worktree, so checkouts can run side by
# side; update PUBLIC_URL with WEB_PORT. In Docker, PORT is the container's port.
# WEB_PORT=3000
# PORT=3001

# The least severe level the BFF logs: debug, info, warn, error or silent.
# Lines are JSON when NODE_ENV=production (as in the image), text otherwise.
# LOG_LEVEL=info

# Postgres connection, matching `yarn db:up`.
DATABASE_URL=postgres://booking:booking@localhost:5432/booking

# Signs the short-lived sign-in cookie. At least 32 random characters in
# production: `openssl rand -base64 33`.
SESSION_SECRET=change-me

# The identity provider: any OpenID Connect provider, with a confidential
# client whose redirect URI is ${PUBLIC_URL}/auth/callback. These match the
# local Keycloak from `yarn keycloak:up` (users ada / ada and grace / grace).
OIDC_ISSUER=http://localhost:8180/realms/booking
OIDC_CLIENT_ID=booking-web
OIDC_CLIENT_SECRET=booking-web-dev-secret
