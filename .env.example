# Public address of the site, used for canonical URLs, the sitemap and social
# metadata. Read at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev server port, read by `yarn dev`. `yarn setup` sets it in a git worktree, so
# several checkouts can run at once. Update AUTH_URL and NEXT_PUBLIC_SITE_URL too.
# PORT=3000

# Postgres connection, matching `yarn db:up`. Copy this file to .env
DATABASE_URL=postgres://booking:booking@localhost:5432/booking

# Auth.js. Encrypts and signs the session cookie. Generate one with
# `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=change-me
# The site's public address. Sign-in links in emails use it, never the request's
# Host header. In production, set it to the same value as NEXT_PUBLIC_SITE_URL.
AUTH_URL=http://localhost:3000

# Magic-link sign-in by email: any SMTP server works. This one is Mailpit from
# `yarn mail:up`, which catches the emails at http://localhost:8025.
AUTH_EMAIL_SERVER=smtp://localhost:1025
AUTH_EMAIL_FROM=BookingHub <no-reply@localhost>

# Sign in with Google: see "Authentication" in the README to create the client.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional: who may sign in, as comma-separated addresses and @domains, such as
# `ada@example.com,@example.com`. Empty means anyone with an email address.
AUTH_ALLOWED_EMAILS=
