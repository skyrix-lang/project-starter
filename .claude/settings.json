{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn verify)",
      "Bash(yarn format)",
      "Bash(yarn format:check)",
      "Bash(yarn check)",
      "Bash(yarn lint)",
      "Bash(yarn test:unit)",
      "Bash(yarn test)",
      "Bash(yarn test e2e/:*)",
      "Bash(yarn build)",
      "Bash(yarn setup)",
      "Bash(yarn db:up)",
      "Bash(yarn mail:up)",
      "Bash(yarn db:generate:*)",
      "Bash(yarn db:migrate)",
      "Bash(yarn db:seed:*)",
      "Bash(yarn dev:session:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ]
  }
}
