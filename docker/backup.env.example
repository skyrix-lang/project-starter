# Template for backup.env, on the server only, next to .env.production
# (README, "Backups"): where scripts/backup-remote.sh uploads the database.
# Never commit the real one. Create it readable by its owner only:
#   install -m 600 /dev/null ~/apps/booking-platform/backup.env
#
# A Cloudflare R2 bucket, and an API token with "Object Read & Write" on that
# bucket only (R2 → Manage API tokens). The account ID is on R2's overview
# page, and is the part before .r2.cloudflarestorage.com in the S3 endpoint.
R2_ACCOUNT_ID=
R2_BUCKET=booking-platform-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
