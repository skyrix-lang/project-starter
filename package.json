{
  "name": "booking-platform",
  "version": "1.0.0",
  "description": "Booking platform starter: React SPA + Hono BFF",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@booking/api": "workspace:^",
    "@booking/core": "workspace:^",
    "@booking/db": "workspace:^",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "yarn workspace @booking/web build && yarn workspace @booking/bff build",
    "start": "STATIC_DIR=${STATIC_DIR:-apps/web/dist} node --env-file-if-exists=.env --enable-source-maps apps/bff/dist/server.js",
    "verify": "yarn format:check && yarn check && yarn lint && yarn boundaries && yarn api:check && yarn test:unit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "yarn workspaces foreach -A --parallel --exclude booking-platform run check && tsc --noEmit -p .",
    "lint": "oxlint --type-aware --deny-warnings",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "api:generate": "tsx scripts/api.ts",
    "api:check": "tsx scripts/api.ts check",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "setup": "tsx scripts/setup.ts",
    "dev:session": "tsx scripts/dev-session.ts",
    "db:up": "sh scripts/db-up.sh",
    "db:down": "docker stop booking-db",
    "keycloak:up": "sh scripts/keycloak-up.sh",
    "keycloak:down": "docker stop booking-keycloak",
    "db:generate": "yarn workspace @booking/db drizzle-kit generate",
    "db:migrate": "yarn workspace @booking/db drizzle-kit migrate",
    "db:studio": "yarn workspace @booking/db drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "docker:build": "docker build -t $npm_package_name:$npm_package_version -f docker/Dockerfile ."
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module"
}
