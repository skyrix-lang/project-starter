{
  "name": "booking-platform",
  "version": "1.0.0",
  "description": "Book a platform",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "devDependencies": {
    "@next/env": "^16.4.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "^16.4.4",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.4",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "eslint .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "db:up": "sh scripts/db-up.sh",
    "db:down": "docker stop booking-db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "check": "echo '[check] Running compilation...'; tsc --noEmit && echo '[check] Compilation succeeded without errors.' && exit 0 || echo '[check] Compilation failed, please check.' && exit 1",
    "clean": "rm -rf .next out",
    "docker:build": "docker build --no-cache --build-arg NEXT_PUBLIC_SITE_URL -t $npm_package_name:$npm_package_version -f docker/Dockerfile ."
  }
}
