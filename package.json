{
  "name": "booking-platform",
  "version": "1.0.0",
  "description": "Book a platform",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "devDependencies": {
    "@next/env": "^16.4.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@heroicons/react": "^2.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.4",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "oxlint --deny-warnings",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "db:up": "sh scripts/db-up.sh",
    "db:down": "docker stop booking-db",
    "mail:up": "sh scripts/mail-up.sh",
    "mail:down": "docker stop booking-mail",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "check": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "docker:build": "docker build --no-cache --build-arg NEXT_PUBLIC_SITE_URL -t $npm_package_name:$npm_package_version -f docker/Dockerfile .",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  }
}
